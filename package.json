{
  "name": "matcha-wiki",
  "version": "1.0.0",
  "description": "Русская вики и исправленный форк Matcha Flavoured.",
  "author": {
    "name": "ArieX",
    "url": "https://github.com/AriesAlex"
  },
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://matcha.ariex.ru/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriesAlex/matcha-wiki.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "data": "bun run localization --check && bun run vanilla:assets && bun run scripts/generate-wiki-data.ts",
    "localization": "bun run scripts/localize-pack-text.ts",
    "vanilla:assets": "bun run scripts/prepare-vanilla-assets.ts",
    "vanilla:sync": "bun run scripts/sync-vanilla-language.ts && bun run scripts/prepare-vanilla-assets.ts --refresh",
    "dev": "bun run data && nuxt dev",
    "build": "bun run data && nuxt build",
    "generate": "bun run data && nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "pack:normalize": "bun run scripts/normalize-pack-filter.ts",
    "pack": "bun run scripts/build-pack.ts",
    "validate": "bun run pack:normalize --check && bun run data && bun run lint && bun run typecheck && bun run test && bun run generate && bun run pack",
    "postinstall": "bun run data && nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.0",
    "@fontsource/tiny5": "5.3.0",
    "@nuxt/content": "3.15.2",
    "@nuxtjs/sitemap": "8.3.1",
    "@phosphor-icons/vue": "2.2.1",
    "@vueuse/core": "14.4.0",
    "better-sqlite3": "12.5.0",
    "minecraft-motd-util": "1.1.12",
    "nuxt": "4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/node": "^25.0.0",
    "eslint": "10.8.0",
    "fflate": "0.8.3",
    "nuxt-yandex-metrika": "2.0.2",
    "sass": "1.102.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8",
    "yaml": "2.9.0"
  }
}
